<script src="https://unpkg.com/flickity@2/dist/flickity.pkgd.min.js"></script>
<script src="<%= asset_path 'javascript/carousel.js' %>" defer></script>

<% if format %>
    <% extension="#{format}" %>
    <% small_extension="#{format}" %>
<% else %>
    <% extension='png' %>
    <% small_extension='webp' %>
<% end %>


<% ratio = screenshot_width.to_f / thumbnail_width %>
<% height = get_image_height("_images/projects/#{id}/screenshot-1.#{extension}") / ratio %>

<div class="carousel" style="height:<%= height %>px">
    <% for i in 1..count %>
        <% figure = define_image("_images/projects/#{id}/screenshot-#{i}.#{extension}", "images/projects/#{id}")%>
        
        <div class="carousel-cell" style="width:<%= thumbnail_width %>px;height:<%= height %>px">
            <% unless width == thumbnail_width && format %>
                <% figure.add_format(extension, width).add_format(small_extension, thumbnail_width) %>
                <a href="<%= relative_url figure.render(0) %>">
                    <img class="carousel-image" src="<%= relative_url figure.render(1) %>" />
                </a>
            <% else %>
                <a href="<%= relative_url figure.render() %>">
                    <img class="carousel-image" src="<%= relative_url figure.render() %>" />
                </a>
            <% end %>
        </div>
    <% end %>
</div>