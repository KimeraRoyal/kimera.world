<!doctype html>
<html lang="<%= site.locale %>">
  <head>
    <% if data.titlebar %>
      <% title = data.titlebar %>
    <% else %>
      <% title = data.title %>
    <% end %>

    <% if data.subtitle %>
      <% subtitle = data.subtitle %>
    <% else %>
      <% subtitle = nil %>
    <% end %>
    <%= render "head", metadata: site.metadata, title: title, subtitle: subtitle %>
    
    <% if data.feed %>
      <link rel="alternate" type="application/rss+xml" title="feed" href="<%= data.feed %>"/>
    <% end %>
  </head>
  <body class="<%= data.layout %> <%= data.page_class %>">
    <%= render Shared::Navbar.new(metadata: site.metadata, resource: resource) %>

    <main class="content-box">
      <% if data.icon %>
        <% icon = data.icon %>
      <% else %>
        <% icon = nil %>
      <% end %>
      <%= render "titlebar", label: title, icon: icon %>

      <div class="content">
        <%= yield %>
      </div>
    </main>

    <%= render "footer", metadata: site.metadata %>
  </body>
</html>
