<!doctype html>
<html lang="<%= site.locale %>">
  <head>
    <% if data.hidden == true %>
      <meta name="robots" content="noindex" />
    <% end %>
    <%= render "head", metadata: site.metadata, title: data.title %>
  </head>
  <% if data.page_class %>
    <% body_class = "#{data.layout}-#{data.page_class}" %>
  <% else %>
    <% body_class = data.layout %>
  <% end  %>
  <body class="<%= body_class %>">
    <main>
      <%= yield %>
    </main>
  </body>
</html>
